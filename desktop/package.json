{
  "name": "fivemshop-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "FivemShop — oferty i rozmowy klientów",
  "main": "main.cjs",
  "author": "FivemShop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pl.pykucreative.fivemshop",
    "productName": "FivemShop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "ui/**/*",
      "connection.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "ui/logo.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "compression": "normal",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "FivemShop-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pykucreative-jpg",
        "repo": "Pyku-Creative-Bot",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pykucreative-jpg/Pyku-Creative-Bot.git",
    "directory": "desktop"
  }
}
